# GEMINI_API_KEY: Required for direct Gemini AI API calls.
# Keep commented when using Firebase AI Logic or Sample AI mode.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Facebook Webhook Verification Token & Meta Graph API v21.0 Page Access Token.
# Configure real values securely in the Secrets panel in AI Studio.
FB_VERIFY_TOKEN=MY_FB_VERIFY_TOKEN
FB_PAGE_ACCESS_TOKEN=MY_FB_PAGE_ACCESS_TOKEN

# Telegram Bot API Token for /webhook/telegram dispatch.
# Configure real values securely in the Secrets panel in AI Studio.
TELEGRAM_BOT_TOKEN=MY_TELEGRAM_BOT_TOKEN
